{
  "name": "rcip-workspace",
  "private": true,
  "version": "2.0.3",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:pilot",
    "build:lib": "npm run build --workspace @binaried/rcip",
    "build:pilot": "npm run build --workspace @rcip/pilot-web",
    "check": "npm run lint && npm run typecheck && npm run build && npm run pack:check",
    "dev": "npm run build:lib && npm run dev --workspace @rcip/pilot-web",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/check-package.mjs && npm run pack:lint && npm run pack:consumers",
    "pack:consumers": "node scripts/check-consumers.mjs",
    "pack:lint": "publint packages/rcip --strict && attw --pack packages/rcip --entrypoints . ./core ./react ./explorer ./assist --profile node16 --quiet",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck:lib && npm run build:lib && npm run typecheck:pilot",
    "typecheck:lib": "npm run typecheck --workspace @binaried/rcip",
    "typecheck:pilot": "npm run typecheck --workspace @rcip/pilot-web",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4186",
    "site:build": "node scripts/build-site.mjs",
    "measure:bundles": "npm run build:lib && node scripts/measure-bundles.mjs",
    "test:site": "playwright test --config playwright.site.config.ts",
    "health:availability": "node scripts/health-availability.mjs",
    "health:regression": "node scripts/health-regression.mjs",
    "check:starter": "node scripts/check-starter.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "vitepress": {
      "vite": "^6.4.3"
    }
  }
}
