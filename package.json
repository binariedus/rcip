{
  "name": "rcip-workspace",
  "private": true,
  "version": "2.0.0",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:pilot",
    "build:lib": "npm run build --workspace @binaried/rcip",
    "build:pilot": "npm run build --workspace @rcip/pilot-web",
    "check": "npm run lint && npm run typecheck && npm run build && npm run pack:check",
    "dev": "npm run build:lib && npm run dev --workspace @rcip/pilot-web",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/check-package.mjs && npm run pack:lint && npm run pack:consumers",
    "pack:consumers": "node scripts/check-consumers.mjs",
    "pack:lint": "publint packages/rcip --strict && attw --pack packages/rcip --entrypoints . ./core ./react ./explorer ./assist --profile node16 --quiet",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck:lib && npm run build:lib && npm run typecheck:pilot",
    "typecheck:lib": "npm run typecheck --workspace @binaried/rcip",
    "typecheck:pilot": "npm run typecheck --workspace @rcip/pilot-web"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    }
  }
}
