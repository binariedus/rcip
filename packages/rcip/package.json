{
  "name": "@binaried/rcip",
  "version": "2.0.0",
  "description": "React Component Interface Protocol: a semantic capability control plane for React applications.",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "ai",
    "capabilities",
    "semantic-interface",
    "application-protocol",
    "tooling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binariedus/rcip.git",
    "directory": "packages/rcip"
  },
  "homepage": "https://github.com/binariedus/rcip#readme",
  "bugs": {
    "url": "https://github.com/binariedus/rcip/issues"
  },
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./explorer": {
      "import": {
        "types": "./dist/explorer/index.d.ts",
        "default": "./dist/explorer/index.js"
      },
      "require": {
        "types": "./dist/explorer/index.d.cts",
        "default": "./dist/explorer/index.cjs"
      }
    },
    "./explorer/styles.css": "./styles/explorer.css",
    "./assist": {
      "import": {
        "types": "./dist/assist/index.d.ts",
        "default": "./dist/assist/index.js"
      },
      "require": {
        "types": "./dist/assist/index.d.cts",
        "default": "./dist/assist/index.cjs"
      }
    },
    "./assist/styles.css": "./styles/assist.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "react": "^19.1.1"
  }
}
